# Copy to .env only if you need to change something. `npm run demo` works with NO .env at all.
PORT=8787
DATA_DIR=.data
DEMO_START=2026-10-08T19:30:00-07:00
# AUTH_MODE=dev accepts "Bearer dev-<person>" (local demo only). Spec auth adds AUTH_MODE=oauth.
AUTH_MODE=dev
# AWS (optional; spec aws-deploy). Setting TABLE_NAME switches FileStore -> DynamoStore.
# AWS_REGION=us-east-1
# TABLE_NAME=thread-state
# OAUTH_JWK_JSON={"kty":"EC",...}        # ES256 private JWK (injected by CDK from SSM on Lambda)
# OAUTH_CLIENT_SECRET=change-me          # alexa-sim client secret (from SSM on Lambda)
# LIVE_AGENT=                            # non-empty enables the Bedrock live agent (off by default)
# LIVE_AGENT_DAILY_CAP=50                # per-day cap on live agent calls
