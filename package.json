{
  "name": "thread-alexa",
  "version": "0.1.0",
  "private": true,
  "description": "THREAD for Alexa+: an MCP server, MCP App and simulator that keep real-world commitments alive. Built on thread-core.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "demo": "node --env-file-if-exists=.env server/local.ts",
    "latency": "node server/latency.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:lens": "vite build --config web/lens/vite.config.ts",
    "build:sim": "vite build --config web/sim/vite.config.ts",
    "verify": "node scripts/verify.mjs",
    "synth": "cdk synth",
    "deploy": "cdk deploy --require-approval broadening"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1147.0",
    "@aws-sdk/lib-dynamodb": "3.1147.0",
    "@hono/node-server": "2.1.4",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "hono": "4.13.13",
    "jose": "6.2.12",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "thread-core": "https://github.com/learnermaker/thread-core/releases/download/v0.1.0/thread-core-0.1.0.tgz",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.164",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "aws-cdk": "2.1145.0",
    "aws-cdk-lib": "2.272.0",
    "constructs": "10.8.1",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
